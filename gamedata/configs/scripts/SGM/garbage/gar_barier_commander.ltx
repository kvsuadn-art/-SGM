[logic]
active = move@commander
on_death = death

[death]
on_info = %+gar_barier_commander_fail% ;=gar_create_propusk

[move@commander]
target_type     = level_vertex
dest_number     = 345247
state_in_center = choose
state_for_move  = walk
miss_center     = false
look_vertex     = 341721
meet            = meet@commander
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true

[meet@commander]
meet_state	= 3|nil@nil
meet_state_wpn	= 3|nil@nil
victim		= 3|actor
victim_wpn	= 3|actor
precond 	= usability
sound_start 	= characters_voice\scenario\darkvalley\val_freedom_leader_meet_1
sound_stop 	= characters_voice\scenario\darkvalley\val_freedom_leader_meet_bye_3
use		= {!actor_enemy} true, false
use_wpn		= {!actor_enemy} true, false
abuse		= false
quest_npc       = true
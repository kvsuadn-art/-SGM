[logic]
active = move@bankir
on_death = death

[death]
on_info = %=respawn_gar_stalker_bankir%

[move@bankir]
target_type     = level_vertex
dest_number     = 255326
state_in_center = guard
state_for_move  = walk
miss_center     = false
look_vertex     = 248855
meet            = meet@bankir

[meet@bankir]
meet_state	= 3|nil@nil
meet_state_wpn	= 3|nil@nil
victim		= 3|actor
victim_wpn	= 3|actor
precond 	= usability
sound_start 	= agr_secret_trader_meet
sound_stop 	= agr_secret_trader_meet_bye
use		= {!actor_enemy} true, false
use_wpn		= {!actor_enemy} true, false
abuse		= false
quest_npc       = true
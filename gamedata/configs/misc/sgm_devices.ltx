[sleeping_bag]:identity_immunities
GroupControlSection	= spawn_group
discovery_dependency    =
$spawn 		        = "device\sleeping_bag"
$prefetch 		= 32
class			= II_ANTIR
cform                   = skeleton
visual                  = dynamics\equipments\documents_7.ogf
inv_name		= sleeping_bag_title
inv_name_short		= sleeping_bag_title
description		= sleeping_bag_descr
random_sleep_a          = 1
random_sleep_b          = 6
cost			= 0
inv_weight		= 0.00
can_trade	        = false
inv_grid_width	        = 2
inv_grid_height		= 2
inv_grid_x		= 32
inv_grid_y		= 16
eat_health              = 0
eat_satiety             = 0
eat_power               = 0
eat_radiation           = 0
wounds_heal_perc        = 0
eat_portions_num        = 1
animation_slot		= 4
hud                     = wpn_vodka_hud
quest_item 	        = true
;-------------;

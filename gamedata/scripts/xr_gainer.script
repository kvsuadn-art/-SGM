---=============================================================================================---
---------------------------------------------------------------------------------------------------
--------------------------(Схема чистки и сноса предметов, из трупов)------------------------------
---------------------------------------------------------------------------------------------------
---=============================================================================================---
------------------------------------
----------/Переменные/--------------
------------------------------------
local allow_gainer=false
local item_extended=false
local items_beside=false
local preparate_gainer=false
local currert_gainer=0
local currert_gainer2=0
local corpses_list={}
local corpses_pos={}
local npc_variable={}
------------------------------------
----------/Общие функции/-----------
------------------------------------
--'Индивидуальные переменные
function read_npc_variable(variable,npc_id)
   if npc_variable[npc_id]==nil or npc_variable[npc_id].variable==nil then
      result=nil
   elseif npc_variable[npc_id]~=nil and npc_variable[npc_id].variable~=nil then
      result=npc_variable[npc_id].variable
   end
   return result
end
function clear_all_variable(npc_id)
   npc_variable[npc_id]=nil
end
function setup_npc_variable(variable,boolean,npc_id)
   if npc_variable[npc_id]==nil then
      npc_variable[npc_id]={}
   else
     npc_variable[npc_id].variable=boolean
   end
end
--'Функции для трупа
function add_corpse(victim_id)
  if corpses_list[victim_id]==nil and sgm_functions.preconduction_more_items(victim_id)==true then
     corpses_list[victim_id]=true
     --/give_quick_news(level.object_by_id(victim_id):character_name())
  end
end
function delete_corpse(victim_id)
  if corpses_list[victim_id]~=nil then
     corpses_list[victim_id]=nil
  end
end
function preconduction_corpse(victim_id)
   return corpses_list[victim_id]==nil
end
function preconduction2_corpse(victim_id)
   return corpses_list[victim_id]~=nil
end
function get_corpses(victim_id)
   return corpses_list[victim_id]==true or corpses_list[victim_id]~=nil
end
function list_corpses()
   return corpses_list
end
--'Функции для направления
function add_vector(gainer_id,vector)
    corpses_pos[gainer_id]=vector
end
function get_vector(gainer_id)
   return corpses_pos[gainer_id]~=nil
end
--'Функции для добытчика
function add_gainer(corpse_id,gainer_id)
    corpses_list[corpse_id]=gainer_id
    --/give_quick_news("Труп ["..level.object_by_id(corpse_id):character_name().."] сборщик  ["..level.object_by_id(gainer_id):character_name().."]")
end
function get_gainer(corpse_id)
  if corpses_list[corpse_id]~=true and corpses_list[corpse_id]~=nil then
	return corpses_list[corpse_id]
  end
  return false
end
function alive_gainer(corpse_id)
  if corpses_list[corpse_id]~=true and corpses_list[corpse_id]~=nil then
        local geiner=level.object_by_id(corpses_list[corpse_id])
        if geiner and geiner:alive()==true then
           return true
        elseif geiner and geiner:alive()==false then
           corpses_list[corpse_id]=nil
           return false
        end
  end
  return false
end
--'Условия для true
function checker_exception(npc)
     local get_exceptions = 
     npc:character_community()=="zombied"     or 
     npc:character_community()=="arena_enemy" or
     npc:profile_name()=="actor"              or  
     npc:profile_name()=="actor_bodyguard_soldier1" or
     npc:profile_name()=="actor_bodyguard_soldier2" or 
     npc:profile_name()=="actor_bodyguard_soldier3"
     if get_exceptions then 
        return false
     end
     return true
end
function gainer_module(npc)
   local geiner=level.object_by_id(currert_gainer)
   local corpse=npc
   local corpse_id=npc:id()
   if geiner~=nil then
     local dist=npc:position():distance_to_sqr(geiner:position())<=12
     local is_see=geiner:see(npc)
     if corpse:alive()==false and dist and is_see and xr_gainer.preconduction_corpse(corpse_id) and sgm_functions.preconduction_more_items(corpse_id)==true then
        add_corpse(corpse_id)
     elseif corpse:alive()==false and sgm_functions.preconduction_more_items(corpse_id)==false and (not dist) and (not is_see) then --/preconduction2_corpse(corpse_id)
       delete_corpse(corpse_id)
     end
   end
end
------------------------------------
------------/Условия/---------------
------------------------------------
class "evaluator_rich" (property_evaluator)
function evaluator_rich:__init(name, storage) super (nil, name)
	self.st = storage
end
function evaluator_rich:evaluate()
	local geiner=self.object
	local geiner_name=self.object:character_name()
	local geiner_profile=self.object:profile_name()
	local enemy=self.object:best_enemy()
	local npc=self.object
        local sourse_list=list_corpses()
        local active_scheme=db.storage[self.object:id()].active_scheme
        if geiner~=nil and allow_gainer==false and checker_exception(geiner) then
              local gainer_id=geiner:id()
              currert_gainer=geiner:id()
              if sourse_list and allow_gainer==false then
                    for k,v in pairs(sourse_list) do
                        local corpse=level.object_by_id(k)
                        if corpse and geiner:parent()==nil then
                              if geiner:accessible(corpse:level_vertex_id()) and geiner:clsid()==clsid.script_stalker and geiner:alive() then
                                  local dist_to_corpse=corpse:position():distance_to_sqr(geiner:position())<=12
                                  if corpses_list[k]==true and dist_to_corpse then
                                     add_gainer(k,gainer_id)
                                  end
                                  if enemy~=nil and geiner then
                                     local dist_to_enemy=geiner:position():distance_to(enemy:position())>90
                                     if get_gainer(k)==gainer_id and alive_gainer(k)==true and dist_to_enemy then
                                        currert_gainer2=self.object:id()
                                        return true
                                     end
                                  elseif enemy==nil then
                                     if get_gainer(k)==gainer_id and alive_gainer(k)==true then
                                        currert_gainer2=self.object:id()
                                        return true
                                     end
                                  end
                              end
                        end
                    end
              end
	end
        return false
end


------------------------------------
------------/Действие/--------------
------------------------------------
class "action_geiner" (action_base)
function action_geiner:__init (npc,action_name,storage) super (nil,action_name)
	self.st = storage
end
function action_geiner:initialize()
	action_base.initialize(self)
	local geiner=self.object
        self.object:set_desired_position()
        self.object:set_desired_direction()
        self.object:clear_animations()
        self.object:set_detail_path_type(move.line)
        self.object:set_body_state(move.standing)
        self.object:set_movement_type(move.run)
        self.object:set_path_type(game_object.level_path)
        self.object:set_mental_state(anim.free)
        self.object:set_sight(look.danger, nil, 0)
        self.object:remove_all_restrictions()
        self.object:disable_talk()
end
function action_geiner:execute()
	action_base.execute(self)
	local npc=self.object
	local geiner=self.object
        if db.actor~=nil then
                local get_corpses=list_corpses()
                if get_corpses then
                     for k,v in pairs(get_corpses) do
                         local corpse=level.object_by_id(k)
                         if corpse then
                           if allow_gainer==false then
                             if distance_between_safe(geiner,corpse)<=1.3 then
                                   sgm_flags.currert_geiner=self.object:id()
                                   --/give_quick_news("труп["..level.object_by_id(k):character_name().."]  вор["..level.object_by_id(get_gainer(k)):character_name().."]")
                                   --'Включение анимации
                                   if preparate_gainer==false and sgm_flags.geiner_preparate_timer==0 then
                                       state_mgr.set_state(npc,"search",nil,nil,{look_object=corpse},{animation=true})
                                       preparate_gainer=true
                                       sgm_flags.geiner_preparate_timer=time_global()+math.random(4000,5800)
                                       --/give_quick_news("Включение анимации")
                                   end
                                   --'Через 4 сек. обыск трупа, который длиться 5 сек
                                   if preparate_gainer==true and sgm_flags.geiner_preparate_timer~=0 and time_global()>=sgm_flags.geiner_preparate_timer then
                                       if sgm_flags.geiner_convert_timer==0 then
                                       sgm_flags.geiner_convert_timer=time_global()+math.random(4500,5200)
                                       end
                                       sgm_functions.convert_item(self.object:id(),k)
                                       item_extended=true
                                       --/give_quick_news("Конвертация")
                                       --'Отключение схемы
                                       if item_extended==true and items_beside==false and sgm_flags.geiner_convert_timer~=0 and time_global()>=sgm_flags.geiner_convert_timer then
                                           items_beside=true
                                           --/give_quick_news("Переключение на RESET")
                                       end
                                       if items_beside==true then
                                               allow_gainer=false
                                               item_extended=false
                                               preparate_gainer=false
                                               items_beside=false 
                                               delete_corpse(k)
                                               sgm_flags.geiner_convert_timer=0
                                               sgm_flags.geiner_preparate_timer=0
                                               --/give_quick_news("Сброс")
                                       end
                                   end
                             elseif distance_between_safe(geiner,corpse)>1.3 and distance_between_safe(geiner,corpse)<=8 then
                                   if sgm_flags.geiner_move_timer==0 then
                                       local geiner_target=level.vertex_in_direction(corpse:level_vertex_id(),vector():set(0,0,0),3)
                                       local get_utils=utils.send_to_nearest_accessible_vertex(npc,geiner_target)
                                       npc:disable_talk()
                                       state_mgr.set_state(npc,"walk")
                                       sgm_flags.geiner_move_timer=time_global()+math.random(700,800)
                                   end
                             elseif distance_between_safe(geiner,corpse)>8 then
                                   if sgm_flags.geiner_move_timer==0 then
                                       local geiner_target=level.vertex_in_direction(corpse:level_vertex_id(),vector():set(0,0,0),3)
                                       local get_utils=utils.send_to_nearest_accessible_vertex(npc,geiner_target)
                                       npc:disable_talk()
                                       state_mgr.set_state(npc,"sprint")
                                       sgm_flags.geiner_move_timer=time_global()+math.random(1000,1200)
                                   end
                             end
                           end
                         end
                     end
                end
        end
end
function action_geiner:finalize()
	action_base.finalize (self)
        allow_gainer=false
        item_extended=false
        preparate_gainer=false
        items_beside=false 
        sgm_flags.geiner_allow_timer=0
        sgm_flags.geiner_preparate_timer=0
        sgm_flags.geiner_convert_timer=0
        sgm_flags.currert_geiner=0
        --/give_quick_news("Откл. Схема")
end


------------------------------------
------------/Планировка/------------
------------------------------------
property_gainer             = 71713
act_gainer                  = property_gainer+1

function add_to_binder(object,ini,scheme,section,storage)
     if checker_exception(object)==true and has_alife_info("activate_scheme_gainer") then
        --'Эвалуаторы
	local manager = object:motivation_action_manager() --/планировщик
        manager:add_evaluator(property_gainer,evaluator_rich("property_gainer",storage))
	local action = action_geiner(object,"action_geiner",storage)
	action:add_precondition(world_property(stalker_ids.property_alive,true))
	--/action:add_precondition(world_property(stalker_ids.property_enemy,false))
	action:add_precondition(world_property(xr_evaluators_id.sidor_wounded_base,false))
	action:add_precondition(world_property(property_gainer,true))
	action:add_effect(world_property(property_gainer,false))
	manager:add_action(act_gainer,action)
	--'Разрешить раздражители
	action = manager:action (xr_actions_id.alife)
	action:add_precondition (world_property(property_gainer,false))
	action = manager:action (stalker_ids.action_combat_planner)
	action:add_precondition (world_property(property_gainer,false))
	action = manager:action (stalker_ids.action_danger_planner)
	action:add_precondition (world_property(property_gainer,false))
     end
end

------------------------------------
------------/Функции/---------------
------------------------------------
function set_scheme(npc, ini, scheme, section)
 local st = xr_logic.assign_storage_and_bind(npc, ini, scheme, section)
end
function disable_scheme(npc, scheme)
 local st = db.storage[npc:id()][scheme]
 if st then
  st.enabled = false
 end
end



-----------------------------------(Схема сборщика предм.)-----------------------------------------
---------------------------------------------------------------------------------------------------
---=============================================================================================---
------------------------------------
----------/Переменные/--------------
------------------------------------
local item_extended=false
local items_beside=false
local preparate_picker=false
local spisok_trupikov={}
local currert_picker=0
local entry_picker=0
local teleport_list = {
{70,"test_npc"}
}
------------------------------------
----------/Общие функции/-----------
------------------------------------
function preconduction_corpse(victim_id)
   return spisok_trupikov[victim_id]==nil
end
function picker_module(npc)
   local picker=level.object_by_id(currert_picker)
   local corpse=npc
   local corpse_id=npc:id()
   if picker~=nil then
     local dist=npc:position():distance_to_sqr(picker:position())<=12
     if corpse:alive()==false and dist and is_see and xr_picker.preconduction_corpse(corpse_id) and sgm_functions.preconduction_more_items(corpse_id)==true then
        add_corpse(corpse_id)
     elseif corpse:alive()==false and sgm_functions.preconduction_more_items(corpse_id)==false and (not dist) then --/preconduction2_corpse(corpse_id)
        delete_corpse(corpse_id)
     end
   end
end
--'Функции для трупа
function add_corpse(victim_id)
  if spisok_trupikov[victim_id]==nil and sgm_functions.preconduction_more_items(victim_id)==true then
     spisok_trupikov[victim_id]=true
  end
end
function delete_corpse(victim_id)
  if spisok_trupikov[victim_id]~=nil then
     spisok_trupikov[victim_id]=nil
  end
end
function list_trupikov()
   return spisok_trupikov
end
function alive_picker(corpse_id)
  if spisok_trupikov[corpse_id]~=true and spisok_trupikov[corpse_id]~=nil then
        local picker=level.object_by_id(spisok_trupikov[corpse_id])
        if picker and picker:alive()==true then
           return true
        elseif picker and picker:alive()==false then
           spisok_trupikov[corpse_id]=nil
           return false
        end
  end
  return false
end
function get_picker(corpse_id)
  if spisok_trupikov[corpse_id]~=true and spisok_trupikov[corpse_id]~=nil then
	return spisok_trupikov[corpse_id]
  end
  return false
end
function get_evaluate_bool(npc)
	local picker=npc
	local picker_name=npc:character_name()
	local picker_profile=npc:profile_name()
	local enemy=npc:best_enemy()
	local npc=npc
        local sourse_list=list_trupikov()
        if picker~=nil then
              local picker_id=picker:id()
              if sourse_list then
                    for k,v in pairs(sourse_list) do
                        local corpse=level.object_by_id(k)
                        if corpse then
                              if picker:clsid()==clsid.script_stalker and picker:alive() then
                                  if spisok_trupikov[k]==true and dist_to_corpse then
                                     add_picker(k,picker_id)
                                  end
                                  if get_picker(k)==picker_id then
                                        entry_picker=npc:id()
                                        return true              
                                  end
                              end
                        end
                    end
              end
	end
        return false
end
------------------------------------
------------/Условие/---------------
------------------------------------
class "evaluator_picker" (property_evaluator)
function evaluator_picker:__init(name, storage) super (nil, name)
	self.st = storage
end
function evaluator_picker:evaluate()
        currert_picker=self.object:id()
        if xr_logic.is_active(self.object,self.st) then
		return true
	end
	return false
end
------------------------------------
------------/Действие/--------------
------------------------------------
class "action_picker" (action_base)
function action_picker:__init (npc,action_name,storage) super (nil,action_name)
	self.st = storage
end
function action_picker:initialize()
	action_base.initialize(self)
	local npc=self.object
        self.object:set_desired_position()
        self.object:set_desired_direction()
        self.object:clear_animations()
        self.object:set_detail_path_type(move.line)
        self.object:set_body_state(move.standing)
        self.object:set_movement_type(move.walk)
        self.object:set_path_type(game_object.level_path)
        self.object:set_mental_state(anim.free)
        self.object:set_sight(look.danger, nil, 0)
        self.object:remove_all_restrictions()
        self.napravlenie=vector():set(math.random()*6-3,0,math.random()*6-3)
        self.napravlenie:normalize()
end
function action_picker:execute()
    action_base.execute(self)
    local npc=self.object
    local actor_pos=db.actor:position()
    if get_evaluate_bool(npc)==false then
           local restore_pos=level.vertex_in_direction(db.actor:level_vertex_id(),self.napravlenie,5)
           local get_actor_lv=db.actor:level_vertex_id()  
           local get_utils=utils.send_to_nearest_accessible_vertex(npc,restore_pos)
           for k,v in pairs(teleport_list) do
                 if npc:profile_name()==v[2] and distance_between_safe(db.actor,npc)>v[1] then
                    alife():release(alife():object(npc:id()),true)
                    create(v[2],actor_pos.x+2,actor_pos.y,actor_pos.z-2,db.actor:level_vertex_id(),db.actor:game_vertex_id())
	         end
           end
           if distance_between_safe(db.actor,npc)>60 then
             if sgm_flags.picker_vector_timer==0 then
             if state_mgr.get_state(npc)~="run" then
             state_mgr.set_state(npc,"run")
             end
             sgm_flags.picker_vector_timer=time_global()+math.random(900,1200)
             end
           elseif distance_between_safe(db.actor,npc)>8 and distance_between_safe(db.actor,npc)<=60 then
             if sgm_flags.picker_vector_timer==0 then
             if state_mgr.get_state(npc)~="assault" then
             state_mgr.set_state(npc,"assault")
             end
             sgm_flags.picker_vector_timer=time_global()+math.random(900,1200)
             end
           elseif distance_between_safe(db.actor,npc)<=8 then
             if sgm_flags.picker_vector_timer==0 then     
             if state_mgr.get_state(npc)~="guard" then
             state_mgr.set_state(npc,"guard")
             end
             sgm_flags.picker_vector_timer=time_global()+math.random(900,1200)
             end
           end
   end
   local picker=self.object
   if get_evaluate_bool(npc)==true then
                give_quick_news("get_evaluate_bool true")
                local get_corpses=list_trupikov()
                if get_corpses then
                     for k,v in pairs(get_corpses) do
                         local corpse=level.object_by_id(k)
                         if corpse then
                             if distance_between_safe(picker,corpse)<=1.3 then
                                   sgm_flags.currert_picker=self.object:id()
                                   --/give_quick_news("труп["..level.object_by_id(k):character_name().."]  вор["..level.object_by_id(get_picker(k)):character_name().."]")
                                   --'Включение анимации
                                   if preparate_picker==false and sgm_flags.picker_preparate_timer==0 then
                                       state_mgr.set_state(npc,"search",nil,nil,{look_object=corpse},{animation=true})
                                       preparate_picker=true
                                       sgm_flags.picker_preparate_timer=time_global()+math.random(4000,5800)
                                       --/give_quick_news("Включение анимации")
                                   end
                                   --'Через 4 сек. обыск трупа, который длиться 5 сек
                                   if preparate_picker==true and sgm_flags.picker_preparate_timer~=0 and time_global()>=sgm_flags.picker_preparate_timer then
                                       if sgm_flags.picker_convert_timer==0 then
                                       sgm_flags.picker_convert_timer=time_global()+math.random(4500,5200)
                                       end
                                       sgm_functions.convert_item(self.object:id(),k)
                                       item_extended=true
                                       --/give_quick_news("Конвертация")
                                       --'Отключение схемы
                                       if item_extended==true and items_beside==false and sgm_flags.picker_convert_timer~=0 and time_global()>=sgm_flags.picker_convert_timer then
                                           items_beside=true
                                           delete_corpse(k)
                                           --/give_quick_news("Переключение на RESET")
                                       end
                                       if items_beside==true then
                                               item_extended=false
                                               preparate_picker=false
                                               items_beside=false 
                                               sgm_flags.picker_convert_timer=0
                                               sgm_flags.picker_preparate_timer=0
                                               --/give_quick_news("Сброс")
                                       end
                                   end
                             elseif distance_between_safe(picker,corpse)>1.3 and distance_between_safe(picker,corpse)<=8 then
                                   if sgm_flags.picker_move_timer==0 then
                                       local picker_target=level.vertex_in_direction(corpse:level_vertex_id(),vector():set(0,0,0),3)
                                       local get_utils=utils.send_to_nearest_accessible_vertex(npc,picker_target)
                                       npc:disable_talk()
                                       state_mgr.set_state(npc,"walk")
                                       sgm_flags.picker_move_timer=time_global()+math.random(700,800)
                                   end
                             elseif distance_between_safe(picker,corpse)>8 then
                                   if sgm_flags.picker_move_timer==0 then
                                       local picker_target=level.vertex_in_direction(corpse:level_vertex_id(),vector():set(0,0,0),3)
                                       local get_utils=utils.send_to_nearest_accessible_vertex(npc,picker_target)
                                       npc:disable_talk()
                                       state_mgr.set_state(npc,"sprint")
                                       sgm_flags.picker_move_timer=time_global()+math.random(1000,1200)
                                   end
                             end
                         end
                     end
                end
     end
end
function action_picker:death_callback()
end
function action_picker:hit_callback()
end
function action_picker:reset_scheme()
	action_base.finalize(self)
        item_extended=false
        preparate_picker=false
        items_beside=false 
        sgm_flags.picker_allow_timer=0
        sgm_flags.picker_preparate_timer=0
        sgm_flags.picker_convert_timer=0
        sgm_flags.currert_picker=0
end
------------------------------------
------------/Планировка/------------
------------------------------------
property_picker  = 71449
add_to_picker    = property_picker

function add_to_binder(object,ini,scheme,section,storage)
        --'Эвалуаторы
	local manager = object:motivation_action_manager() --/планировщик
	manager:add_evaluator(property_picker,evaluator_picker("picker",storage))
	local action = action_picker(object,"picker",storage)
	action:add_precondition(world_property(stalker_ids.property_alive,true))
	action:add_precondition(world_property(xr_evaluators_id.sidor_wounded_base,false))
	action:add_precondition(world_property(property_picker,true))
	action:add_effect(world_property(property_picker,false))
	manager:add_action(add_to_picker,action)
        xr_logic.subscribe_action_for_events(object,storage,action)
	--'Разрешить раздражители
	action = manager:action(xr_actions_id.alife)	
	action:add_precondition(world_property(property_picker,false))
end
------------------------------------
------------/Функции/---------------
------------------------------------
function set_scheme(npc, ini, scheme, section, gulag_name)
	printf("DEBUG: set_scheme: scheme='%s', section='%s'", scheme, section)
	local st = xr_logic.assign_storage_and_bind(npc, ini, scheme, section)
	printf("DEBUG: set_scheme: storage assigned")
	st.logic     = xr_logic.cfg_get_switch_conditions(ini, section, npc)
        --/
        st.picker_follow_actor    = utils.cfg_get_bool(ini,section,"picker_follow_actor",npc,false,false)
        st.picker_body_distance   = utils.cfg_get_number(ini,section,"picker_body_distance",npc,false,0)
        st.picker_dialog_unpack   = utils.cfg_get_bool(ini,section,"picker_dialog_unpack",npc,false,false)
        st.use_command            = utils.cfg_get_string(ini,section,"use_command",npc,false,"",nil)
        --/
end
function disable_scheme(npc, scheme)
 local st = db.storage[npc:id()][scheme]
 if st then
  st.enabled = false
 end
end


function convert_item(gainer_id,corpse_id)
     local gainer=level.object_by_id(gainer_id)
     local corpse=level.object_by_id(corpse_id)
     if gainer~=nil and corpse~=nil then
        for k,v in pairs(all_items_list) do
            if corpse:object(v[1]) then
               corpse:transfer_item(corpse:object(v[1]),gainer)
               --/give_quick_news("от="..corpse:character_name().."  что="..v[1])
            end
        end
     end
end
function preconduction_more_items(corpse_id)
     local corpse=level.object_by_id(corpse_id)
     if corpse~=nil then
        for z,w in pairs(all_items_list) do
            if corpse:object(w[1]) then
               return true
            end
        end
     end
     return false
end
function write_variable(params_name,value)
	if value==nil then
	    clear_variable(params_name)
	else
	    local opt=story_params(params_name)
	    pstor_store(db.actor,opt,value)
            --/news_manager.starting_send_tip(db.actor,"Write: "..opt,0,"universal",4000)
	end
end
function read_variable(params_name)
	local opt=story_params(params_name)
	return pstor_retrieve(db.actor,opt)
end
function clear_variable(params_name)
	local opt=story_params(params_name)
	if db.storage[db.actor:id()].pstor[opt] then
	    db.storage[db.actor:id()].pstor[opt]=nil
         --/news_manager.starting_send_tip(db.actor,"Clear: "..opt.." = nil",0,"universal",4000)
	end
end
function story_params(params)
return params
end
function pstor_store(obj,varname,val)
        if obj==nil then return nil end
	local sub_id=obj:id()
	if db.storage[sub_id].pstor==nil then
		db.storage[sub_id].pstor={}
	end
	db.storage[sub_id].pstor[varname]=val
end
function pstor_retrieve(obj,varname)
        if obj==nil then return nil end
	local sub_id=obj:id()
	if db.storage[sub_id].pstor~=nil then
		local val=db.storage[sub_id].pstor[varname]
		if val~=nil then
		return val
		end
	end
	return nil
end
function info_get_number(info)
       if info~=nil then
             if has_alife_info(info) then
                result=1
             else
                result=0
	     end
       end
       return result
end
function info_get_boolean(info)
       if info~=nil then
             if has_alife_info(info) then
                result=true
             else
                result=false
	     end
       end
       return result
end
function info_give_on_number(value,info)
       if value~=nil and info~=nil then
             if value==1 then
                db.actor:give_info_portion(info)
             else
                db.actor:disable_info_portion(info)
	     end
       end
end
function info_give_on_boolean(value,info)
       if value~=nil and info~=nil then
             if value==true then
                db.actor:give_info_portion(info)
             else
                db.actor:disable_info_portion(info)
	     end
       end
end

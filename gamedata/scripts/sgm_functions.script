end
function get_explorers_deaths(place)
   if place=="crossing" then
      if has_alife_info("mar_explorer_crossing1_death") and has_alife_info("mar_explorer_crossing2_death") and has_alife_info("mar_explorer_crossing3_death") and has_alife_info("mar_explorer_crossing4_death") then
         result=true
      else
         result=false
      end
   elseif place=="khutor" then
      if has_alife_info("mar_explorer_khutor1_death") and has_alife_info("mar_explorer_khutor2_death") and has_alife_info("mar_explorer_khutor3_death") and has_alife_info("mar_explorer_khutor4_death") then
         result=true
      else
         result=false
      end
   elseif place=="village" then
      if has_alife_info("mar_explorer_village1_death") and has_alife_info("mar_explorer_village2_death") and has_alife_info("mar_explorer_village3_death") then
         result=true
      else
         result=false
      end
   elseif place=="railway" then
      if has_alife_info("mar_explorer_railway1_death") and has_alife_info("mar_explorer_railway2_death") then
         result=true
      else
         result=false
      end
   elseif place=="ruins" then
      if has_alife_info("esc_explorer_ruins1_death") and has_alife_info("esc_explorer_ruins2_death") then
         result=true
      else
         result=false
      end
   end
   return result
end
function get_explorers_deaths2(place)
   if place=="ruins" then
      if has_alife_info("esc_force_ruins_deaths") then
         result=true
      else
         result=false
      end
   end
   return result
end
function is_smart_captured(smart_name,faction_name)
	if smart_name~=nil and faction_name~=nil then
          local result=sim_board.get_sim_board().smarts_by_names[smart_name].player_name
	  return result==faction_name
	end
	return false
end
function is_smart_captured2(smart_name,faction_name)
	if smart_name~=nil and faction_name~=nil then
          local result=sim_board.get_sim_board().smarts_by_names[smart_name].player_name
	  return result==faction_name or result=="none" or result=="nil"
	end
	return false
end
function is_smart_no_captured(smart_name)
	if smart_name~=nil then
          local result=sim_board.get_sim_board().smarts_by_names[smart_name].player_name
	  return result=="none" or result=="nil"
	end
	return false
end
function is_squad_spawned(squad_id)
	if squad_id~=nil then
	  local board = sim_board:get_sim_board()
          local result=board.squads[squad_id]
	  return result~=nil
	end
	return false
end
function is_squad_no_spawned(squad_id)
	if squad_id~=nil then
	  local board = sim_board:get_sim_board()
          local result=board.squads[squad_id]
	  return result==nil
	end
	return false
end

function get_smart_squads(smart_name)
   if smart_name~=nil then
      local result=sim_board.get_sim_board():get_smart_population(sim_board.get_sim_board().smarts_by_names[smart_name])
      return result
   end
   return nil
end

function hero_in_faction(faction_name)
	for k,v in pairs(sim_board.get_sim_board().players) do
		if v.community_player==true and v.player_name==faction_name then
		return true
		end
	end
	return false
end

function enemy_found_tips_module(object)
        local npc=object
        local get_enemy=object:best_enemy()
        local get_npc_name=level.object_by_id(object:id()):character_name()
        local get_npc_community=level.object_by_id(object:id()):character_community()
        local stalker_vs_bandit_tip=stalker_vs_bandit_texts[math.random(table.getn(stalker_vs_bandit_texts))]
        local stalker_vs_renegade_tip=stalker_vs_renegade_texts[math.random(table.getn(stalker_vs_renegade_texts))]
        local stalker_vs_zombied_tip=stalker_vs_zombied_texts[math.random(table.getn(stalker_vs_zombied_texts))]
        local stalker_vs_killer_tip=stalker_vs_killer_texts[math.random(table.getn(stalker_vs_killer_texts))]
        local stalker_vs_military_tip=stalker_vs_military_texts[math.random(table.getn(stalker_vs_military_texts))]
        local stalker_vs_monolith_tip=stalker_vs_monolith_texts[math.random(table.getn(stalker_vs_monolith_texts))]
        local dolg_vs_bandit_tip=dolg_vs_bandit_texts[math.random(table.getn(dolg_vs_bandit_texts))]
        local dolg_vs_renegade_tip=dolg_vs_renegade_texts[math.random(table.getn(dolg_vs_renegade_texts))]
        local dolg_vs_zombied_tip=dolg_vs_zombied_texts[math.random(table.getn(dolg_vs_zombied_texts))]
        local dolg_vs_killer_tip=dolg_vs_killer_texts[math.random(table.getn(dolg_vs_killer_texts))]
        local dolg_vs_military_tip=dolg_vs_military_texts[math.random(table.getn(dolg_vs_military_texts))]
        local dolg_vs_monolith_tip=dolg_vs_monolith_texts[math.random(table.getn(dolg_vs_monolith_texts))]
        local freedom_vs_bandit_tip=freedom_vs_bandit_texts[math.random(table.getn(freedom_vs_bandit_texts))]
        local freedom_vs_renegade_tip=freedom_vs_renegade_texts[math.random(table.getn(freedom_vs_renegade_texts))]
        local freedom_vs_zombied_tip=freedom_vs_zombied_texts[math.random(table.getn(freedom_vs_zombied_texts))]
        local freedom_vs_killer_tip=freedom_vs_killer_texts[math.random(table.getn(freedom_vs_killer_texts))]
        local freedom_vs_military_tip=freedom_vs_military_texts[math.random(table.getn(freedom_vs_military_texts))]
        local freedom_vs_monolith_tip=freedom_vs_monolith_texts[math.random(table.getn(freedom_vs_monolith_texts))]
        local csky_vs_bandit_tip=csky_vs_bandit_texts[math.random(table.getn(csky_vs_bandit_texts))]
        local csky_vs_renegade_tip=csky_vs_renegade_texts[math.random(table.getn(csky_vs_renegade_texts))]
        local csky_vs_zombied_tip=csky_vs_zombied_texts[math.random(table.getn(csky_vs_zombied_texts))]
        local csky_vs_killer_tip=csky_vs_killer_texts[math.random(table.getn(csky_vs_killer_texts))]
        local csky_vs_military_tip=csky_vs_military_texts[math.random(table.getn(csky_vs_military_texts))]
        local csky_vs_monolith_tip=csky_vs_monolith_texts[math.random(table.getn(csky_vs_monolith_texts))]
        if sgm_functions.read_variable("fill_npc_enemy")==nil then sgm_functions.write_variable("fill_npc_enemy","none") end
        if sgm_functions.read_variable("fill_npc_time")==nil  then sgm_functions.write_variable("fill_npc_time",0) end
        if sgm_functions.read_variable("fill_npc_enemy")=="show" and get_enemy~=nil then
           if get_enemy~=nil and IsStalker(get_enemy) and level.object_by_id(object:id()):alive()==true and get_npc_community~=nil then
             local get_enemy_community=get_enemy:character_community()
             if get_enemy_community~=nil then
              if get_npc_community=="stalker" then
                if get_enemy_community=="bandit" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,stalker_vs_bandit_tip,1,"stalker",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="renegade" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,stalker_vs_renegade_tip,1,"stalker",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="zombied" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,stalker_vs_zombied_tip,1,"stalker",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="killer" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,stalker_vs_killer_tip,1,"stalker",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="army" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,stalker_vs_military_tip,1,"stalker",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="monolith" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,stalker_vs_monolith_tip,1,"stalker",6000,nil,get_npc_name..":")
                end
              elseif get_npc_community=="dolg" then
                if get_enemy_community=="bandit" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,dolg_vs_bandit_tip,1,"dolg",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="renegade" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,dolg_vs_renegade_tip,1,"dolg",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="zombied" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,dolg_vs_zombied_tip,1,"dolg",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="killer" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,dolg_vs_killer_tip,1,"dolg",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="army" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,dolg_vs_military_tip,1,"dolg",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="monolith" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,dolg_vs_monolith_tip,1,"dolg",6000,nil,get_npc_name..":")
                end

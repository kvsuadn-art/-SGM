                elseif get_enemy_community=="killer" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,csky_vs_killer_tip,1,"csky",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="army" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,csky_vs_military_tip,1,"csky",6000,nil,get_npc_name..":")
                elseif get_enemy_community=="monolith" then
                    sgm_functions.write_variable("fill_npc_enemy","have")
                    news_manager.send_tip(db.actor,csky_vs_monolith_tip,1,"csky",6000,nil,get_npc_name..":")
                end
              end
             end
           end
        end
        if sgm_functions.read_variable("fill_npc_time")~=nil and sgm_functions.read_variable("fill_npc_enemy")=="have" and sgm_functions.read_variable("fill_npc_time")==0 then 
           sgm_functions.write_variable("fill_npc_enemy","none")
        end
        if sgm_functions.read_variable("fill_npc_time")~=nil and sgm_functions.read_variable("fill_npc_time")>0 and time_global()>=sgm_functions.read_variable("fill_npc_time") then 
           sgm_functions.write_variable("fill_npc_time",0)
           sgm_functions.write_variable("fill_npc_enemy","show")
        end
        if sgm_functions.read_variable("fill_npc_time")~=nil and sgm_functions.read_variable("fill_npc_enemy")=="none" and sgm_functions.read_variable("fill_npc_time")==0 then 
           sgm_functions.write_variable("fill_npc_time",time_global()+math.random(180000,300000))
        end
end
function npc_range_module(object)
    local npc=object
    if get_exception(object)==true then
        if level.get_time_hours()>=5 and level.get_time_hours()<=22 then
           if (not has_alife_info("blackday_is_active")) and npc:range()<=40 then
           npc:set_range(60)
           end
        else
           if (not has_alife_info("blackday_is_active")) and npc:range()>40 then
           npc:set_range(20)
           end
        end
        if has_alife_info("blackday_is_active") then
           if npc:range()>40 then
           npc:set_range(15)
           end
        end
    end
end
function on_death_module(self,killer)
        sgm_flags.unique_death_snd="off"
        sgm_flags.victim_prof=level.object_by_id(self.id):profile_name()                           --/Профиль жертвы
        sgm_flags.victim_name=level.object_by_id(self.id):character_name()                         --/Имя жертвы
        sgm_flags.victim_id=self.id                                                                --/ID жертвы
        sgm_flags.victim_death_h=level.get_time_hours()                                            --/Час смерти
        sgm_flags.victim_death_m=level.get_time_minutes()                                          --/Минута смерти
        if level.object_by_id(self.id):profile_name()~=nil then
           if level.object_by_id(self.id):profile_name()=="esc_explorer_ruins1" then
              db.actor:give_info_portion("esc_explorer_ruins1_death")
           elseif level.object_by_id(self.id):profile_name()=="esc_explorer_ruins2" then
              db.actor:give_info_portion("esc_explorer_ruins2_death")
           elseif level.object_by_id(self.id):profile_name()=="esc_driver" then
              alife():create("dv_army_driver_case",vector(),0,0,self.id)
           end
        end
        level.map_remove_object_spot(self.id,"alife_presentation_squad_friend")
        level.map_remove_object_spot(self.id,"alife_presentation_squad_neutral")
        level.map_remove_object_spot(self.id,"bodyguard_npc_location")
        level.map_remove_object_spot(self.id,"bankir_npc_location")
        level.map_remove_object_spot(self.id,"squad_commander_location")
        level.map_remove_object_spot(self.id,"hide_trader_location")
        level.map_remove_object_spot(self.id,"quest_npc_location")
        level.map_remove_object_spot(self.id,"breeder_location")
        level.map_remove_object_spot(self.id,"alife_presentation_squad_friend")
        level.map_remove_object_spot(self.id,"alife_presentation_squad_neutral")
        level.map_remove_object_spot(self.id,"alife_presentation_squad_enemy")
        level.map_remove_object_spot(self.id,"alife_presentation_squad_attack_point")
        level.map_remove_object_spot(self.id,"alife_presentation_enemy_squad_attack_point")
        level.map_remove_object_spot(self.id,"alife_presentation_neutral_squad_attack_point")
        level.map_remove_object_spot(self.id,"alife_presentation_friend_squad_attack_point")
end
function profile_update(object)
        local npc=object
        local prof=object:profile_name()
        if npc~=nil and profiles_names[prof]==nil then
        add_prof_name(prof,true)
        elseif npc~=nil and profiles_names[prof]==true then
        add_prof_id(prof,npc:id())
        end
        for k,v in pairs(profiles_list) do
          if prof==v[1] then
            add_prof_id(v[1],npc:id())
	  end
        end
        --'Показать HUD сообщение про активную секцию'--
        --/show_logic_section(object,"esc_stalker_novice_quest") 
end
function physic_update(object)
        for k,v in pairs(physic_update_list) do
         if object:section()==v[1] then
            add_prof_id(v[1],object:id())
	 end
        end
end
function scheme_update(object)
        for k,v in pairs(scheme_update_list) do
         if object:profile_name()==v[1] and v[2]=="true" then
            add_prof_id(v[1],object:id())
	 end
        end
end
function create_update(who,ids)
       for k,v in pairs(create_update_one_list) do
         if who==v[1] then
            add_prof_id(v[2],ids)
	 end
       end
       for z,h in pairs(create_update_two_list) do
         if who==h[1] then
            level.map_add_object_spot_ser(ids,h[3],h[2])
	 end
       end
       for s,b in pairs(create_update_three_list) do
         if who==b[1] then
            level.map_add_object_spot_ser(ids,b[3],b[2])
	 end
       end
end
function release_exclude(obj)
        for w,i in pairs(release_exclude_list) do
           if obj:profile_name()==i[1] then
              return true
	   end
        end
        return false
end
------------------------------------
----------/Общие функции/-----------
------------------------------------
function add_prof_name(profile,val)
    if profiles_names[profile]==nil then
    profiles_names[profile]=val
    --/give_quick_news("add_prof_name: профиль="..profile)
    end
end
function add_prof_id(profile,id)
    if profiles_ids[profile]==nil then
    profiles_ids[profile]=id
    --/give_quick_news("add_prof_id: профиль="..profile.."  Айдишник="..id)
    end
end
function add_prof_id2(profile,id)
    if profiles_ids[profile]==nil then
    profiles_ids[profile]=id
    end
end
function get_exception(npc)
     local get_exceptions = 
     npc:profile_name()=="val_freedom_rpg_trooper"
     if get_exceptions then 
        return false
     end
     return true
end
function pre_profile_id(profile)
	if profiles_ids[profile]~=nil then
	   return true
	end
	return false
end
function get_profile_id(profile)
	if profiles_ids[profile]~=nil then
	   return profiles_ids[profile]
	elseif profiles_ids[profile]==nil and profiles_ids[profile.."_spot"]~=nil then
	   return profiles_ids[profile.."_spot"]
	end
	return nil
end

function callback_for_take_item_from_box(box,item)
  local sect=box:section()
  local item_sect=item:section()
  --/give_quick_news(item_sect)
  if find_in_string(sect,"dv_") then
     if level.map_has_object_spot(box:id(),"deserve")~=0 then
     level.map_remove_object_spot(box:id(),"deserve")
     level.map_remove_object_spot(box:id(),"deserve")
     level.map_remove_object_spot(box:id(),"deserve")
     level.map_remove_object_spot(box:id(),"deserve")
     end
  end
end

function callback_on_use(sect)
  local sect=sect:section()
  local actor_pos=db.actor:position() 
  local active_slot=db.actor:active_slot()
  local active_item=db.actor:active_item()
  local pistol_in_slot=db.actor:item_in_slot(1)
  local rifle_in_slot=db.actor:item_in_slot(2)
  local outfit_in_slot=db.actor:item_in_slot(6)
  local artefact_in_slot=db.actor:item_in_slot(3)
  local actor=db.actor
  local pistol_contain
  local rifle_contain
  local outfit_contain
  local artefact_contain
  if outfit_in_slot~=nil then outfit_contain=outfit_in_slot:section() end
  if pistol_in_slot~=nil then pistol_contain=pistol_in_slot:section() end
  if rifle_in_slot~=nil  then rifle_contain=rifle_in_slot:section()   end
  if sect=="psy_complex" or sect=="medkit_elite" then
     db.actor.psy_health=1.0
  elseif sect=="repair_arms_box" and (pistol_contain~=nil or rifle_contain~=nil) then
        if pistol_in_slot~=nil then
        local pistol_name=sgm_functions.ReadCaption(pistol_in_slot:section())
        local pistol_cond=string.format(math.floor(pistol_in_slot:condition()*100)).."%"
        news_manager.send_repair(pistol_name,pistol_cond)
        pistol_in_slot:set_condition(1.0)
        end
        if rifle_in_slot~=nil then
        local rifle_name=sgm_functions.ReadCaption(rifle_in_slot:section())
        local rifle_cond=string.format(math.floor(rifle_in_slot:condition()*100)).."%"
        news_manager.send_repair(rifle_name,rifle_cond)
        rifle_in_slot:set_condition(1.0)
        end
  elseif sect=="repair_outfit_box" and outfit_contain~=nil then
     local outfit_name=sgm_functions.ReadCaption(outfit_in_slot:section())
     local outfit_cond=string.format(math.floor(outfit_in_slot:condition()*100)).."%"
     news_manager.send_repair(outfit_name,outfit_cond)
     outfit_in_slot:set_condition(1.0)
  elseif sect=="personal_rukzak" then
     create("treasure_rukzak",actor_pos.x,actor_pos.y,actor_pos.z,db.actor:level_vertex_id(),db.actor:game_vertex_id())
  elseif find_in_string(sect,"medal_rank") then
     param_m=sgm_functions.GetMedalMoney(sect)
     dialogs.relocate_money(db.actor,param_m,"in")
  elseif sect=="ananas" or sect=="vodka" or sect=="conserva" or sect=="kolbasa" or sect=="bread" or sect=="bun" then
     param_satiety=sgm_functions.GetSatietySlakeFactor(sect)
     sgm_functions.write_variable("satiety_factor",sgm_functions.read_variable("satiety_factor")-param_satiety)
  end
end
function callback_for_deserves(sect)
  local sect=sect:section()
  local actor_pos=db.actor:position() 
  if find_in_string(sect,"dv_") then
     param_what=sect.."_unpack"
     param_x=sgm_functions.GetDeserveX(sect)
     param_y=sgm_functions.GetDeserveY(sect)
     param_z=sgm_functions.GetDeserveZ(sect)
     param_lv=sgm_functions.GetDeserveLV(sect)
     param_gv=sgm_functions.GetDeserveGV(sect)
     param_title=sgm_functions.GetDeserveTitle(sect)
     param_descr=sgm_functions.GetDeserveDescr(sect)
     param_items=sgm_functions.GetDeserveItems(sect)
     param_table=utils.parse_spawns(param_items)   --/parse_names(param_items)
     local deserve=alife():create(param_what,vector():set(param_x,param_y,param_z),param_lv,param_gv)
     for k,v in pairs(param_table) do
         if ammo_section[v.section]==true then
             --/box_size=sgm_functions.ReadAmmoSize(v)
	     se_respawn.create_ammo(v.section,vector(),0,0,deserve.id,v.prob)
	 else
             for i=1,v.prob do
                 alife():create(v.section,vector(),0,0,deserve.id)
             end
         end
     end
     if level.map_has_object_spot(deserve.id,"deserve")==0 then
     level.map_add_object_spot_ser(deserve.id,"deserve",param_descr)
     end
     news_manager.send_deserve(param_title)
  end
end
function callback_for_skills(sect)
  local sect=sect:section()
  if find_in_string(sect,"skill_book") then
     skill_target=sgm_functions.GetSkillTarget(sect)
     target_caption=sgm_functions.ReadCaption(skill_target)
     db.actor:give_info_portion(sect)
     news_manager.send_add_skill(target_caption)
  elseif find_in_string(sect,"outfit_upgrade_") then
     upgrade_target=sgm_functions.GetSkillTarget(sect)
     target_title=sgm_functions.ReadCaption(upgrade_target)
     db.actor:give_info_portion(sect)
     news_manager.send_add2_skill(target_title)
  end
end
function callback_for_sleep(sect)
  local sect=sect:section()
  local actor_pos=db.actor:position() 
  if find_in_string(sect,"sleeping_bag") and sgm_functions.read_variable("allow_sleep")==true then
     if (level.get_time_hours()>=21 and level.get_time_hours()<=23) or level.get_time_hours()<6 then
     sleeping_rnd_a=sgm_functions.GetSleepBagRandomA(sect)
     sleeping_rnd_b=sgm_functions.GetSleepBagRandomB(sect)
     --/db.actor:stop_talk()
     level.disable_input()
     use_bleeding_mode()
     use_power_mode(0.98,1.00)
     use_immortal_mode(0.98,1.00)
     level.add_pp_effector("mar_fade.ppe",76424,false)
     sgm_flags.sleep_value=level.get_time_hours()+math.random(sleeping_rnd_a,sleeping_rnd_b)
     sgm_flags.sleep_value2=time_global()+3000
     level.set_time_factor(1700)
     level.hide_indicators_safe()
     local hud = get_hud()
     hud:HideActorMenu()
     hud:HidePdaMenu()
     else
     game.start_tutorial("about_actor_no_sleep")
     local hud = get_hud()
     hud:HideActorMenu()
     end
  elseif find_in_string(sect,"sleeping_bag") and sgm_functions.read_variable("allow_sleep")==false then
     game.start_tutorial("about_dont_sleep_place")
     local hud = get_hud()
     hud:HideActorMenu()
  end
end


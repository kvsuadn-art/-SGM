function callback_for_update()
     local pistol=db.actor:item_in_slot(1)
     local rifle=db.actor:item_in_slot(2)
     local outfit=db.actor:item_in_slot(6)
     if pistol and pistol:section()~=nil then
        if sgm_flags.old_wpn1~=pistol:section() then
           sgm_flags.old_wpn1=pistol:section()
           wpn_caption=sgm_functions.ReadCaption(pistol:section())
           need_info=sgm_functions.GetSkillInfo(pistol:section())
           if need_info~=nil and has_alife_info(need_info) then
           news_manager.send_currert_skill(wpn_caption)
           end
        end
     else
        sgm_flags.old_wpn1=nil
     end
     if rifle and rifle:section()~=nil then
        if sgm_flags.old_wpn2~=rifle:section() then
           sgm_flags.old_wpn2=rifle:section()
           wpn_caption=sgm_functions.ReadCaption(rifle:section())
           need_info=sgm_functions.GetSkillInfo(rifle:section())
           if need_info~=nil and has_alife_info(need_info) then
           news_manager.send_currert_skill(wpn_caption)
           end
        end
     else
        sgm_flags.old_wpn2=nil
     end
     if outfit~=nil and outfit:section()~=nil then
        outfit_info=sgm_functions.GetOutfitInfo(outfit:section())
        outfit_delta=sgm_functions.GetOutfitDelta(outfit:section())
        if outfit_info~=nil and has_alife_info(outfit_info) then
           if sgm_flags.outfit_upgrade_timer==0 and outfit:condition()<1.0 then
              outfit:set_condition(1.0)
              sgm_flags.outfit_upgrade_timer=time_global()+outfit_delta
           end
        end
     end
end
function callback_on_hit(victim,amount,local_direction,who,bone_index)
  local active_slot=db.actor:active_slot()
  local active_item=db.actor:active_item()
  local pistol_in_slot=db.actor:item_in_slot(1)
  local rifle_in_slot=db.actor:item_in_slot(2)
  if victim~=nil and active_item and who:clsid()==clsid.script_actor then
     local active_sect=active_item:section()
     --/if find_in_string(active_sect,"wpn_") then
        param_info=sgm_functions.GetSkillInfo(active_sect)
        param_point=sgm_functions.GetSkillPoint(active_sect)
        if param_info~=nil and param_point~=nil and has_alife_info(param_info) then
           local point_s = hit()
           point_s.draftsman = victim
           point_s.type = hit.fire_wound
           point_s.power = param_point
	   point_s.impulse = 0.1
           victim:hit(point_s)
           --/show_hud_message("victim="..victim:name().."  who="..who:name().."  amount="..amount.."  param_point="..param_point)
        end
     --/end
  end
end

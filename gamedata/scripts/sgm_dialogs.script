--------/Торговля: функции заказа/----------
local loaded_cost=0
function write_order(cost)
  if present_night() then
  local result=math.floor(cost/6)
  loaded_cost=result
  else
  local result=math.floor(cost/3)
  loaded_cost=result
  end
end
function custom_order(cost)
  if present_night() then
  loaded_cost=math.floor(cost/2)
  else
  loaded_cost=cost
  end
end
function gar_s_trader_w_1(first_speaker,second_speaker)
  write_order(sgm_functions.ReadCost("wpn_ak78u"))
end
function gar_s_trader_w_2(first_speaker,second_speaker)
  write_order(sgm_functions.ReadCost("wpn_shotgun"))
end

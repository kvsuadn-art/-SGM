function val_freedom_leader_reward(actor,npc)
   local knife_slot=db.actor:item_in_slot(0)
   if knife_slot~=nil and knife_slot:section()~=nil then
      remove_inv_item(db.actor,knife_slot:section())
      dialogs.relocate_item_section(npc,"wpn_knife_up","in")
   end
end
function agr_dolg_leader_reward(actor,npc)
   if not has_alife_info("agr_defend_dolg_reward") then
   local knife_slot=db.actor:item_in_slot(0)
   if knife_slot~=nil and knife_slot:section()~=nil then
      remove_inv_item(db.actor,knife_slot:section())
      dialogs.relocate_item_section(npc,"wpn_knife_up2","in")
      dialogs.relocate_item_section(npc,"skill_book_val","in")
      db.actor:give_info_portion("agr_defend_dolg_reward")
   end
   end
end

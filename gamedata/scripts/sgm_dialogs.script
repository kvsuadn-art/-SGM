local last_add_capital=0
function precondition_about_story(actor,npc)
	if xr_wounded.is_wounded(npc) or
	   xr_wounded.is_heavy_wounded_by_id(npc:id()) or
	   xr_wounded.is_psy_wounded_by_id(npc:id())
	then
		return false
	end
	return true
end
function precondition_for_dialog(actor,npc)
	if xr_wounded.is_wounded(npc) or
	   xr_wounded.is_heavy_wounded_by_id(npc:id()) or
	   xr_wounded.is_psy_wounded_by_id(npc:id())
	then
		return false
	end
	return true
end
function disable_trade(npc)
npc:enable_trade()
end
function enable_trade(npc)
npc:enable_trade()
end
function disable_input()
level.disable_input()
end
function enable_input()
level.enable_input()
end
function disable_ui()
level.show_weapon(false)
level.hide_indicators_safe()
local hud = get_hud()
hud:HideActorMenu()
hud:HidePdaMenu()
end
function enable_ui()
level.show_weapon(true)
level.show_indicators()
end
--/Проверочные функции
function smart_terrain_5_8_is_captured(actor,npc)
	return sgm_functions.is_smart_captured("gar_smart_terrain_5_8","stalker")==true
end
--/Временные функции
function is_deposit_time(actor, npc)
	return level.get_time_hours()==20 and level.get_time_minutes()<=45
end
function is_percent_allow(actor, npc)
	return level.get_time_days()>=sgm_functions.read_variable("actor_ptimer")
end

function bankir_show_deposit(first_speaker,second_speaker)
local currert=sgm_functions.read_variable("actor_deposit")
local task_texture,task_rect = get_texture_info("ui_iconsTotal_found_thing")
db.actor:give_talk_message2("",game.translate_string("st_bankir_counter2")..currert..game.translate_string("st_bankir_ru"),"ui_iconsTotal_found_thing","iconed_answer_item")
end
function bankir_10_percent_money(first_speaker,second_speaker)
local percent=sgm_functions.read_variable("actor_percent")
local task_texture,task_rect = get_texture_info("ui_iconsTotal_found_thing")
db.actor:give_talk_message2("",game.translate_string("st_bankir_percent")..percent,"ui_iconsTotal_found_thing","iconed_answer_item")
end
function bankir_show_deposit_and_10_percent(first_speaker,second_speaker)
local currert=sgm_functions.read_variable("actor_deposit")
local percent=sgm_functions.read_variable("actor_percent")
local task_texture,task_rect = get_texture_info("ui_iconsTotal_found_thing")
db.actor:give_talk_message2("",game.translate_string("st_bankir_counter2").." "..currert.." "..game.translate_string("st_bankir_ru"),"ui_iconsTotal_found_thing","iconed_answer_item")
db.actor:give_talk_message2("",game.translate_string("st_bankir_percent").." "..percent,"ui_iconsTotal_found_thing","iconed_answer_item")
end
function bankir_set_zero_deposit(actor,npc)
 if sgm_functions.read_variable("actor_deposit")==nil then
    sgm_functions.write_variable("actor_deposit",0)
 end
 if sgm_functions.read_variable("actor_percent")==nil then
    sgm_functions.write_variable("actor_percent",0)
 end
 if sgm_functions.read_variable("actor_ptimer")==nil then
    sgm_functions.write_variable("actor_ptimer",0)
 end
 if sgm_functions.read_variable("actor_btimer")==nil then
    sgm_functions.write_variable("actor_btimer",0)
 end
end
function bankir_deposit_add_1000(actor,npc)
local currert=sgm_functions.read_variable("actor_deposit")
sgm_functions.write_variable("actor_deposit",currert+1000)
dialogs.relocate_money(npc,1000,"out")
--/local currert2=sgm_functions.read_variable("actor_percent")
--/sgm_functions.write_variable("actor_percent",currert2+200)
local currert3=sgm_functions.read_variable("actor_ptimer")
    if currert3==level.get_time_days() then
      sgm_functions.write_variable("actor_ptimer",level.get_time_days()+1)
      elseif currert3~=level.get_time_days() then
      sgm_functions.write_variable("actor_ptimer",level.get_time_days()+1)
    end
end

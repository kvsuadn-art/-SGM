function show_order_costs(first_speaker,second_speaker)
  local task_texture,task_rect = get_texture_info("ui_iconsTotal_found_thing")
  db.actor:give_talk_message2("",game.translate_string("st_order_cost").." "..loaded_cost.." "..game.translate_string("st_bankir_ru"),"ui_iconsTotal_found_thing","iconed_answer_item")
end
function order_has_money(actor, npc)
	return db.actor:money()>=loaded_cost
end
function order_less_money(actor, npc)
	return db.actor:money()<loaded_cost
end
function order_give_money(actor, npc)
	dialogs.relocate_money(npc,loaded_cost,"out")	
end
--------/Квесты на поиск/----------
local mar_need_items = {
{"wpn_toz34",900},
{"wpn_bm16",780}
}
function pre_need_items(actor,npc)
   local level_name=level.name()
   if level_name=="marsh" then
        if (not has_alife_info("wpn_toz34")) or (not has_alife_info("wpn_bm16")) then
           return true
        end
   end
   return false
end
function get_need_item(actor,npc)
   local level_name=level.name()
   if level_name=="marsh" then
      for k,v in pairs(mar_need_items) do
        if not has_alife_info(v[1]) then
          currert_caption=sgm_functions.ReadCaption(v[1])
          db.actor:give_talk_message2("","Найти предмет :".." "..game.translate_string(currert_caption),"ui_iconsTotal_found_thing","iconed_answer_item")
        end
      end
   end
end
function has_need_item(actor,npc)
   local level_name=level.name()
   if level_name=="marsh" then
      for k,v in pairs(mar_need_items) do
        if db.actor:object(v[1]) and not has_alife_info(v[1]) then
          return true
        end
      end
   end
   return false
end
function nohas_need_item(actor,npc)
   local level_name=level.name()
   if level_name=="marsh" then
      for k,v in pairs(mar_need_items) do
        if not db.actor:object(v[1]) and not has_alife_info(v[1]) then
          return true
        end
      end
   end
   return false
end
function give_need_item(actor,npc)
   local level_name=level.name()
   if level_name=="marsh" then
      for k,v in pairs(mar_need_items) do
        if db.actor:object(v[1]) and not has_alife_info(v[1]) then
          dialogs.relocate_item_section(npc,v[1],"out")
          dialogs.relocate_money(npc,v[2],"in")
          db.actor:give_info_portion(v[1])
        end
      end
   end
end
--------/Торговля: установка бинокля/----------
function val_show_binos(first_speaker,second_speaker)
   local bino_slot=db.actor:item_in_slot(4)
   if bino_slot~=nil and bino_slot:section()~=nil and bino_slot:section()=="wpn_binoc" then
   db.actor:give_talk_message2("",game.translate_string("st_binocular_m1"),"ui_iconsTotal_binoculars","iconed_answer_item")
   db.actor:give_talk_message2("",game.translate_string("st_binocular_m2"),"ui_iconsTotal_binoculars","iconed_answer_item")
   elseif bino_slot~=nil and bino_slot:section()~=nil and bino_slot:section()=="wpn_binocular_m1" then
   db.actor:give_talk_message2("",game.translate_string("st_binocular_m2"),"ui_iconsTotal_binoculars","iconed_answer_item")
   db.actor:give_talk_message2("",game.translate_string("st_binocular"),"ui_iconsTotal_binoculars","iconed_answer_item")
   elseif bino_slot~=nil and bino_slot:section()~=nil and bino_slot:section()=="wpn_binocular_m2" then
   db.actor:give_talk_message2("",game.translate_string("st_binocular_m1"),"ui_iconsTotal_binoculars","iconed_answer_item")
   db.actor:give_talk_message2("",game.translate_string("st_binocular"),"ui_iconsTotal_binoculars","iconed_answer_item")
   end
end
function agr_show_binos(first_speaker,second_speaker)
   local bino_slot=db.actor:item_in_slot(4)
   if bino_slot~=nil and bino_slot:section()~=nil and bino_slot:section()=="wpn_binoc" then
   db.actor:give_talk_message2("",game.translate_string("st_binocular_m3"),"ui_iconsTotal_binoculars","iconed_answer_item")
   elseif bino_slot~=nil and bino_slot:section()~=nil and bino_slot:section()=="wpn_binocular_m3" then
   db.actor:give_talk_message2("",game.translate_string("st_binocular"),"ui_iconsTotal_binoculars","iconed_answer_item")
   end
end
function selected_other_bino(actor,npc)
   local bino_slot=db.actor:item_in_slot(4)
   if bino_slot~=nil and bino_slot:section()~=nil and bino_slot:section()~="wpn_binoc" then
   return true
   end
   return false
end

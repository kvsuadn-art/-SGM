function all_functions_spawn()
sgm_functions.write_variable("zatm_h_rnd",math.random(10,19))
sgm_functions.write_variable("zatm_m_rnd",math.random(2,57))
sgm_functions.write_variable("actor_capital",0)
sgm_functions.write_variable("actor_deposit",0)
sgm_functions.write_variable("actor_percent",0)
sgm_functions.write_variable("actor_ptimer",0)
sgm_functions.write_variable("actor_btimer",0)
sgm_functions.write_variable("allow_sleep",false)
sgm_functions.write_variable("satiety_factor",0)
end
function update_spawn()

       db.actor:give_info_portion("mil_rpg_ambush_spawner")
   end
end
----------------------------------------------------------------
--------------------------'Лиманск'-----------------------------
----------------------------------------------------------------
if level_name=="limansk" then
   if not has_alife_info("lim_robbery_leader_spawner") then
       create("lim_construction_robbery_leader",6.004,2.998,141.711,28498,1552)
       db.actor:give_info_portion("lim_robbery_leader_spawner")
   end
end

function sigerous_mod_loader()
   sgm_huds.hud_checker()
   sgm_grant.item_works_init()
   sgm_modes.modes_init()
   sgm_effects.effects_init()
   sgm_value_work.values_init()
   sgm_world.update_spawn()
   sgm_info.info_work_init()
   sgm_tasks.sgm_task_init()
   sgm_reinforcement.update_reinforcement()
   sgm_squads.squads_init()
   sgm_news.sgm_news_init()
   sgm_creator.blackday_creator()
   sgm_sleep_places.sleep_places_init()
end



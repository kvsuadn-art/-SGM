--/Функции воспроизведения звуков/--
function play_theme_snd(snd)
     xr_sound.set_sound_play(db.actor:id(),snd)
end
function play_folder_snd(sound)
     snd_sourse=sound_object(sound)
     snd_sourse:play(db.actor,0,sound_object.s2d)
end
function play_snd_at_pos(sound,npc,count1,count2)
     if count1==nil and count2==nil then
     snd_sourse=sound_object(sound)
     snd_sourse:play_at_pos(npc,npc:position(),0,sound_object.s3d)
     elseif count1~=nil and count2~=nil then
     local rnd_snd=math.random(count1,count2)
     snd_sourse=sound_object(sound..rnd_snd)
     snd_sourse:play_at_pos(npc,npc:position(),0,sound_object.s3d)
     end
end
function play_snd_at_actor(sound,count1,count2)
     if count1==nil and count2==nil then
     snd_sourse=sound_object(sound)
     snd_sourse:play(db.actor,0,sound_object.s2d)
     elseif count1~=nil and count2~=nil then
     local rnd_snd=math.random(count1,count2)
     snd_sourse=sound_object(sound..rnd_snd)
     snd_sourse:play(db.actor,0,sound_object.s2d)
     end
end
--/Функции для добавления квестов/--
function add_task(type,task_name,faction)
	local task_type    = type
	local target_name  = task_name
	local faction_name = faction
	local tm = task_manager.get_task_manager()
	local target_obj = nil
	if task_type == "storyline" then
		target_obj = target_name
	elseif task_type == "eliminate_smart" then
		target_obj = sim_board.get_sim_board().smarts_by_names[target_name]
	elseif task_type == "capture_smart" then
		target_obj = sim_board.get_sim_board().smarts_by_names[target_name]
	elseif task_type == "defend_smart" then
		target_obj = sim_board.get_sim_board().smarts_by_names[target_name]
	elseif task_type == "eliminate_squad" then
		target_obj = sim_board.get_sim_board().squads[target_name]
	end
	local task = tm:select_task(task_type,target_obj,faction_name)
	task:give_task(faction_name)
end
function add_eliminate_task(type,task_name,faction,smart_name)
	local tm = task_manager.get_task_manager()
	local target_obj = nil
	if type=="eliminate_smart" then
		target_obj = sim_board.get_sim_board().smarts_by_names[smart_name]
	end
	local task = tm:select_task(type,target_obj,faction)
	task:give_task(faction)
end
--/Функции для респауна експлореров/--
function use_explorer_module(smart_name,faction_name,squad_sect,squad_pos,prefix_info,rnd1,rnd2)
   local level_name = level.name()
   local minutes_time = level.get_time_minutes()
   if rnd1~=nil and rnd2~=nil then
     local rnd_squad=math.random(rnd1,rnd2)
     if sgm_functions.is_smart_captured(smart_name,faction_name)==false and (minutes_time==45 or minutes_time==15) and not has_alife_info(prefix_info.."_switch") then
      create_force(squad_sect..rnd_squad,squad_pos)
      db.actor:give_info_portion(prefix_info.."_switch")
     elseif has_alife_info(prefix_info.."_deaths") and (minutes_time==30 or minutes_time==59 or minutes_time==10) then
      db.actor:disable_info_portion(prefix_info.."_switch")
      db.actor:disable_info_portion(prefix_info.."_deaths")
     end
   else
     if sgm_functions.is_smart_captured(smart_name,faction_name)==false and (minutes_time==45 or minutes_time==15) and not has_alife_info(prefix_info.."_switch") then
      create_force(squad_sect,squad_pos)
      db.actor:give_info_portion(prefix_info.."_switch")
     elseif has_alife_info(prefix_info.."_deaths") and (minutes_time==30 or minutes_time==59 or minutes_time==10) then
      db.actor:disable_info_portion(prefix_info.."_switch")
      db.actor:disable_info_portion(prefix_info.."_deaths")
     end
   end
end
function create_info_explorer(squad_sect,squad_target,need_info)
   local level_name = level.name()
   local minutes_time = level.get_time_minutes()
   if not has_alife_info(need_info) then
      create_force(squad_sect,squad_target)
      db.actor:give_info_portion(need_info)
   end
end
function create_info_explorer2(smart_name,faction_name,squad_sect,squad_target,need_info)
   local level_name = level.name()
   local minutes_time = level.get_time_minutes()
   if sgm_functions.is_smart_captured(smart_name,faction_name)==false and not has_alife_info(need_info) then
      create_force(squad_sect,squad_target)
      db.actor:give_info_portion(need_info)
   end
end
--/Поисковики/--
function find_in_string(where,what)
  if string.find(where,what) then 
  return true 
  end
  return false
end
function find_out_string(where,what)
  if string.find(where,what) then 
  return false
  end
  return true
end
function check_table(tbl)
   for k,v in pairs(tbl) do
       if v~=nil then
          return v
       end
   end
   return nil
end
--/Разные функции/--
function object_alive(victim)
  if victim:alive()==true then 
         return true 
  end
  return false
end
function get_installed_addon(wpn,type)
   if wpn~=nil and type~=nil then
      if type=="scope" then
        result=wpn:weapon_is_scope()
      elseif type=="silencer" then
        result=wpn:weapon_is_silencer()
      elseif type=="launcher" then
        result=wpn:weapon_is_grenadelauncher()
      end
   end
   return result
end
function hero_in_stalker()
   for k,v in pairs(sim_board.get_sim_board().players) do
	if v.community_player == true and v.player_name == "stalker" then
		return true
	end
   end
   return false
end
function remove_inv_item(victim,item)
   if victim~=nil and item~=nil then
      alife():release(alife():object(victim:object(item):id()),true)
   end
end
function variable_precond(type,variable_name,equal_val)
   if type=="equal" then
      if sgm_functions.read_variable(variable_name)~=nil and sgm_functions.read_variable(variable_name)==equal_val then
         return true
      else
         return false
      end
   elseif type=="something" then
      if sgm_functions.read_variable(variable_name)~=nil then
         return sgm_functions.read_variable(variable_name)
      else
         return 0
      end
   end
end
function on_level(level)
   local level_name=level.name()
   if level_name==level then
      return true
   else
      return false
   end
end
function activate_blackday()
   if level.get_time_hours()>=7 and level.get_time_hours()<=20 then
      if sgm_functions.read_variable("zatm_switch")==nil then
         sgm_functions.write_variable("zatm_h_rnd",level.get_time_hours())
         sgm_functions.write_variable("zatm_m_rnd",level.get_time_minutes())
      end
   end
end
function set_community_rel(target_comm,relation_value)
   relation_registry.set_community_relation(target_comm,db.actor:character_community(),relation_value)
end
function present_night()
   if level.get_time_hours()<6 or level.get_time_hours()>=22 then
      return true
   else
      return false
   end
end
function actor_in_sleep_zone(zone_name)
   local zone=db.zone_by_name[zone_name]
   return utils.npc_in_zone(db.actor,zone)
end
function actor_out_sleep_zone(zone_name)
   local zone=db.zone_by_name[zone_name]
   if zone==nil then
   return false
   end
   return not utils.npc_in_zone(db.actor,db.zone_by_name[zone_name])
end
function show_progress_bar(hud_name,xml_name,xml_sect,show_func)
   --/show_progress_bar("hud_hero_rank","rank_progress.xml","rank_bar",db.actor:character_rank())
   local hud=get_hud()
   local xml=CScriptXmlInit()
   if hud:GetCustomStatic(hud_name)==nil then
        hud:AddCustomStatic(hud_name,true)
        xml:ParseFile(xml_name)
        progress_bar=xml:InitProgressBar(xml_sect,hud:GetCustomStatic(hud_name):wnd())
        if hud:GetCustomStatic(hud_name)~=nil then
            hud:AddCustomStatic(hud_name, true)
            bar_level=show_func
            if bar_level>0 then
              progress_bar:Show(true)
              progress_bar:SetProgressPos(bar_level)
            end
        end
   elseif hud:GetCustomStatic(hud_name)~=nil then
        xml:ParseFile(xml_name)
        hud:AddCustomStatic(hud_name,true)
        bar_level=show_func
        if bar_level>0 then
           progress_bar:Show(true)
           progress_bar:SetProgressPos(bar_level)
        end
    end
end
function activate_faction_brain(faction_name)
	local board=sim_board.get_sim_board()
	local player=board.players[faction_name]
	if player==nil then
	abort("Can't find player sgm %s", tostring(p[1]))
	end
	player:faction_brain_update()
end
